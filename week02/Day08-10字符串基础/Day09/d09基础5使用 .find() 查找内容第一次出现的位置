# 使用 .find() 查找内容第一次出现的位置
# 基本语法：位置变量 = 字符串.find("需要查找的内容")///.find() 返回的是 int。
# 规则：
# 找到内容     → 返回第一次出现的位置
# 没有找到     → 返回 -1
# 字符串的位置从 0 开始。

# system_log：用户输入的系统日志
system_log = input("请输入系统日志：")

# error_code_position：错误码E105第一次出现的位置
error_code_position = system_log.find("E105")

print(f"E105错误码的位置：{error_code_position}")

if error_code_position == -1:
    print("未发现E105错误码")
else:
    print("发现E105错误码")