# 用第一条真实数据初始化最大值和最小值

# current_score：第一次输入的评分
current_score = int(input("请输入第1次评分："))

# highest_score：目前发现的最高评分
highest_score = current_score

# lowest_score：目前发现的最低评分
lowest_score = current_score

# score_number：当前评分编号
for score_number in range(2, 6):
    # current_score：当前输入的评分
    current_score = int(
        input(f"请输入第{score_number}次评分：")
    )

    if current_score > highest_score:
        highest_score = current_score

    if current_score < lowest_score:
        lowest_score = current_score

print(f"最高评分：{highest_score}")
print(f"最低评分：{lowest_score}")