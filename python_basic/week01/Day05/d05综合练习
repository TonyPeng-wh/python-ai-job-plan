#   image_is_valid图片是否有效
#   defect_confidence缺陷置信度

image_is_valid = int(input("请输入图片是否有效："))

if image_is_valid == 1:
    defect_confidence = float(input("请输入缺陷置信度"))

    if defect_confidence >= 0.90:
        print("确定存在缺陷，创建质检告警")
    elif defect_confidence >= 0.60:
        print("结果不确定，转人工复核")
    else:
        print("未发现明显缺陷")
else:
    print("图片无效，请重新采集")

print("视觉质检结束")

