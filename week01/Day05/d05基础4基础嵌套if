# 基础嵌套 if
# 1. 基本语法
# if 外层条件:
#     if 内层条件:
#         内层条件成立时执行
#     else:
#         内层条件不成立时执行
# else:
#     外层条件不成立时执行
# 第二个 if 属于第一个 if，所以需要再缩进一次。

"""
2. 工作场景：企业知识库权限检查

员工访问企业 AI 知识库中的内部文档时，系统通常需要先检查：

员工账号是否有效。
账号有效后，再检查是否拥有文档权限。

如果账号已经停用，就没有必要继续检查文档权限。

真实系统会从身份认证系统和权限服务中获得这些数据。本练习暂时使用用户输入的 1 和 0 模拟状态。

规则：

1 表示是
0 表示否
"""

# account_is_active：账号是否有效
account_is_active = int(input("账号是否有效？请输入1或0："))

# has_document_permission：是否拥有文档权限
has_document_permission = int(input("是否拥有文档权限？请输入1或0："))

if account_is_active == 1:
    print("账号状态正常")

    if has_document_permission == 1:
        print("允许访问内部文档")
    else:
        print("没有文档权限，拒绝访问")
else:
    print("账号已停用，拒绝访问")

print("权限检查结束")