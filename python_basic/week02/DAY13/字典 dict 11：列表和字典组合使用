# 6. 工作场景：筛选低质量回答,找出评分低于 0.80 的模型调用。

model_results = [
    {
        "model_name": "deepseek",
        "quality_score": 0.91,
        "request_succeeded": True
    },
    {
        "model_name": "qwen",
        "quality_score": 0.88,
        "request_succeeded": True
    },
    {
        "model_name": "glm",
        "quality_score": 0.72,
        "request_succeeded": False
    }
]
for current_result in model_results:
    model_name = current_result["model_name"]
    quality_score = current_result["quality_score"]

    if quality_score < 0.80:
        print(f"低质量回答模型：{model_name}")

# 7. 另一个典型场景：AI 工单列表
ticket_list = [
