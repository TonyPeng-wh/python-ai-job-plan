# 字典 dict ⑩：使用 for 遍历字典
# 字典也能用 for，只是需要先明确：
# 这一轮到底想取 key、value，还是 key 和 value 一起取。


# 1. 直接遍历字典：默认得到 key
model_result = {
    "model_name": "deepseek",
    "quality_score": 0.91,
    "request_succeeded": True
}
for current_key in model_result:
    print(current_key)

# 2. 拿到 key 后，可以继续读取 value
model_result[current_key]
for current_key in model_result:
    current_value = model_result[current_key]

    print(f"字段：{current_key}")
    print(f"值：{current_value}")

# 3. 使用 keys() 遍历 key
for current_key in model_result.keys():
    print(current_key)

#4. 使用 values() 遍历 value，如果业务上根本不关心字段名，只想处理所有 value：
for current_value in model_result.values():
    print(current_value)

#5. 使用 items() 同时遍历 key 和 value
for current_key, current_value in model_result.items():
    print(f"{current_key}：{current_value}")

"""
for ... in dictionary
→ key

for ... in dictionary.values()
→ value

for key, value in dictionary.items()
→ key + value
"""