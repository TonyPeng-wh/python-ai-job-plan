# 这段代码没问题。
# 现在把“统计回答错误数量”这个功能单独拿出来：
feedback_list = [
    {"category": "回答错误"},
    {"category": "检索失败"},
    {"category": "回答错误"}
]

def count_answer_errors(feedbacks):
    answer_error_count = 0

    for current_feedback in feedbacks:
        if current_feedback["category"] == "回答错误":
            answer_error_count = answer_error_count + 1

    return answer_error_count

result = count_answer_errors(feedback_list)

print(f"回答错误数量：{result}")

"""
为什么要这样写？
原来：
统计逻辑全部写在外面
现在：
count_answer_errors()
→ 专门负责统计回答错误
以后需要统计时，只要：
result = count_answer_errors(feedback_list)
不需要每次重新写一整套：
answer_error_count = 0
for ...
    if ...
        count += 1
这就是函数开始真正用于“整理代码”。
"""

def count_high_priority(feedbacks):
    high_count = 0

    for current_feedback in feedbacks:
        if current_feedback["priority"] == "HIGH":
            high_count = high_count + 1

    return high_count


feedback_list = [
    {"category": "回答错误", "priority": "HIGH"},
    {"category": "检索失败", "priority": "LOW"},
    {"category": "格式问题", "priority": "HIGH"}
]

result = count_high_priority(feedback_list)

print(f"HIGH 优先级数量：{result}")

