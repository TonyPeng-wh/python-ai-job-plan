# highest_score:目前发现最高评分
highest_score = 0

# lowest_score:目前发现最低评分
lowest_score = 1000

# score_number:当前评分编号
for score_number in range(1, 6):

    # current_score:当前输入评分
    current_score = int(
        input(f"第{score_number}次评分为:")
    )

    if current_score > highest_score:
        highest_score = current_score

    if current_score < lowest_score:
        lowest_score = current_score

print(f"最高分为{highest_score}")
print(f"最低分为{lowest_score}")
