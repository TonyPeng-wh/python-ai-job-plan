#   列表排序与反转
# sort()排序
# reverse()把当前顺序完全反过来
# 这两个方法都会直接修改原列表，和 append()、remove() 类似。
#仍然不要重新赋值

model_scores = [0.81, 0.95, 0.73, 0.88]
model_scores.sort()#默认是：从小到大排序。
print(model_scores)

model_names = ["qwen", "gpt", "deepseek", "glm"]
model_names.sort()#会按照字符串的排序规则重新排列这些元素。
print(model_names)

model_scores1 = [0.81, 0.95, 0.73, 0.88]
model_scores1.sort(reverse=True)#反向排序。从大到小。True 是 bool。
print(model_scores1)

model_names1 = ["qwen", "deepseek", "gpt", "glm"]
model_names1.reverse()#是把当前列表顺序倒过来。
print(model_names1)

####工作场景
answer_quality_scores = [0.82, 0.94, 0.76, 0.89]
answer_quality_scores.sort()#查看从最低分到最高分
answer_quality_scores.sort(reverse=True)#查看从最高分到最低分
answer_quality_scores.reverse()#把记录顺序从最新到最旧改为最旧到最新
print(answer_quality_scores)