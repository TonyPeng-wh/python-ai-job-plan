def ticket_needs_review(priority):
    return priority == "HIGH"


def get_review_status(priority):
    if priority == "HIGH":
        return "需要复核"
    else:
        return "正常处理"


current_priority = "HIGH"

needs_review = ticket_needs_review(current_priority)
review_status = get_review_status(current_priority)

print(needs_review)
print(review_status)

