"""
循环累计求和
目标
统计多次大模型调用一共使用了多少 Token。
计数和求和的区别：
计数：每次成功固定加 1
求和：每次加上本次实际产生的数据
"""

# 工作场景
# 系统进行了 3 次大模型调用，需要记录每次的 Token 使用量，并计算总量。
# 真实系统中，这些数据通常来自模型 API 的返回结果；当前练习使用手动输入模拟。
# total_token_count：累计使用的 Token 数量
total_token_count = 0

for request_number in range(1, 4):
    # token_count：当前模型调用使用的 Token 数量
    token_count = int(
        input(f"请输入第{request_number}次模型调用的 Token 数量：")
    )

    total_token_count = total_token_count + token_count

print(f"累计使用的 Token 数量：{total_token_count}")
print("Token 使用量统计结束")