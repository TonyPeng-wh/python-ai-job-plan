"""
d16函数8：参数可以接收 dict
你之前已经学过字典，现在把它和函数连起来。
"""
ticket = {
    "ticket_code": "TK1008",
    "category": "充电故障"
}
def show_ticket(ticket):
    print(f"工单编号：{ticket['ticket_code']}")
    print(f"工单分类：{ticket['category']}")


show_ticket(ticket)
# 函数里的 ticket = 外面的 ticket 字典


