# print(f"第一个字符：{first_character}")



# ticket_code：用户输入并清除两端空白后的工单编号
ticket_code = input("请输入工单编号：").strip()

if len(ticket_code) > 0:
    # source_code：工单编号的第一个字符
    source_code = ticket_code[0]

    print(f"工单编号首字符：{source_code}")

    if source_code == "C":
        print("工单来源：客户提交")
    elif source_code == "A":
        print("工单来源：AI系统自动生成")
    elif source_code == "M":
        print("工单来源：人工录入")
    else:
        print("无法识别工单来源")
else:
    print("工单编号不能为空")