"""
目标:一个函数如何同时接收多个数据。
"""
def show_retrieval_result(document_title, retrieval_score):
    print(f"文档名称：{document_title}")
    print(f"检索分数：{retrieval_score}")
# 这里有两个参数：document_title,retrieval_score
"""
def 函数名(参数1, 参数2):
