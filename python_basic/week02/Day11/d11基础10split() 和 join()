# join()：把多个字符串元素连接成一个字符串
model_names = ["qwen", "deepseek", "gpt"]
model_text = ",".join(model_names)
print(model_text)
print(type(model_text))


# AI 应用场景为什么常用它们？以后做 RAG、工单分类、模型调用时非常常见。
# 比如接口返回一段标签文本：timeout,network,retry
# 你需要逐个处理标签，就可以：
tag_text = "timeout,network,retry"
tags = tag_text.split(",")
for tag in tags:
    print(tag)
result_text = " | ".join(tags)
print(result_text)